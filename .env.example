# ─── Nawaqes Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values.
# ⚠️ NEVER commit .env to version control!
#
# ⚠️ DO NOT set NODE_ENV here! Vite does not support it in .env files.
#    NODE_ENV is set automatically by npm scripts or start.bat
#
# ⚠️ All passwords below will be auto-generated if not set,
#    but it's recommended to set them for production.

# PORT: The port the server runs on (default: 7860 for Hugging Face Spaces)
PORT=7860

# DATABASE_URL: SQLite database path (relative to project root)
DATABASE_URL="file:./data/nawaqes.db"

# JWT_SECRET: Secret key for JWT token signing
# ⚠️ If not set, a random one is generated each time (tokens reset on restart!)
# Generate a permanent one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=nawaqes_secret_2024_xK9pL2mN8qR3wY6

# JWT_EXPIRES_IN: Token expiration time (default: 7 days)
JWT_EXPIRES_IN=7d

# APP_URL: The public URL where this app is hosted
# For Hugging Face Spaces, use: https://safwatkhokha-nawaqes.hf.space
APP_URL=https://safwatkhokha-nawaqes.hf.space

# ─── Admin Account (set before first run) ────────────────────────
# These are used only on first database initialization.
# ⚠️ If not set, random passwords are auto-generated (shown in console).

# Admin account
ADMIN_EMAIL=admin@nawaqes.com
ADMIN_PASSWORD=Admin@2024

# Owner account (super admin)
OWNER_EMAIL=owner@nawaqes.com
OWNER_PASSWORD=Owner@2024

# ─── Firebase Cloud Messaging (Push Notifications) ────────────────
# Get these from Firebase Console > Project Settings
# These values are now configured on HF Spaces
FIREBASE_PROJECT_ID=nawaqes-app
FIREBASE_API_KEY=AIzaSyBIzywCvScpNMgR0WLT6HcalnRy0JhPf0Y
FIREBASE_AUTH_DOMAIN=nawaqes-app.firebaseapp.com
FIREBASE_STORAGE_BUCKET=nawaqes-app.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=1001594480276
FIREBASE_APP_ID=1:1001594480276:web:1edf938f6e7f6e3e303681
FIREBASE_MEASUREMENT_ID=G-M4KEGG4QFF
# VAPID key for web push (generate in Firebase > Cloud Messaging > Web Config)
FIREBASE_VAPID_KEY=
# Path to service account JSON file (for server-side send)
FIREBASE_SERVICE_ACCOUNT_PATH=/data/firebase-service-account.json

# ─── Backup System (set as HF Space Secrets) ────────────────────
# HF_TOKEN: Your Hugging Face token (for auto-backup to HF Datasets)
# HF_BACKUP_REPO: Repository name for backups (default: safwatkhokha/nawaqes-backups)
# JWT_SECRET: Secret key for JWT tokens (prevents session loss on rebuild)

